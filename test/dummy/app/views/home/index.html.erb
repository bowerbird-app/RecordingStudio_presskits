<% dummy_page_nav(title: "Dummy host", back_url: root_path) %>

<div class="flex w-full flex-col gap-6">
  <%= render FlatPack::PageTitle::Component.new(
    title: "Dummy host",
    subtitle: "Studio Workspace already has a press kit and a fake section, so this host is not an empty box.",
    variant: :h1
  ) %>

  <% if @workspace_tree.any? %>
    <%= render FlatPack::Tree::Component.new(compact: true) do |tree| %>
      <% @workspace_tree.each do |node| %>
        <%= render partial: "workspace_tree_node", locals: { parent_builder: tree, node: node } %>
      <% end %>
    <% end %>
  <% else %>
    <%= render FlatPack::Card::Component.new(style: :default) do |card| %>
      <% card.body do %>
        <p class="text-sm leading-6 text-(--surface-content-color)">
          Nothing in this workspace yet. Seed the dummy host to drop in a press kit.
        </p>
      <% end %>
    <% end %>
  <% end %>
</div>
