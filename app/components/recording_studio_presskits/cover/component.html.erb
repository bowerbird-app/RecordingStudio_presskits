<% if card? %>
  <%= render FlatPack::Card::Component.new(
    style: :default,
    hover: :none,
    padding: :none,
    theme: view_button_theme,
    id: wrapper_id,
    class: grid_card_classes,
    data: grid_card_data
  ) do %>
    <%# Tailwind scans these literals: "@container" "@min-[640px]:flex-row" "@min-[640px]:min-h-[50cqw]" "@min-[640px]:aspect-auto" "@min-[640px]:w-1/2" "@min-[640px]:shrink-0" "@min-[640px]:self-stretch" "@min-[640px]:min-w-0" "@min-[640px]:rounded-tr-none" "@min-[640px]:rounded-bl-[var(--radius-lg)]" "aspect-[430/368]" "flex flex-1 flex-col px-8 pt-7" %>
    <div class="<%= grid_card_row_classes %>" style="<%= font_style %>" data-cover-row>
      <div class="<%= grid_card_frame_classes %>" data-cover-frame>
        <% if cover_image? %>
          <div class="absolute inset-0" data-cover-image>
            <%= image_tag cover_image_url, alt: cover_image_alt, class: "h-full w-full object-cover" %>
          </div>
        <% else %>
          <div
            class="absolute inset-0 bg-[var(--surface-muted-background-color)]"
            data-cover-fallback
          ></div>
        <% end %>
        <%# Tailwind scans these literals: "absolute inset-x-0 top-0" "items-start" "justify-between" "gap-3" "p-5" %>
        <div class="absolute inset-x-0 top-0 flex items-start justify-between gap-3 p-5">
          <span class="inline-flex" style="<%= pill_style %>" data-cover-tag data-cover-eyebrow>
            <%= render FlatPack::Badge::Component.new(
              text: eyebrow,
              size: :md,
              style: :primary,
              class: "!border-transparent !px-4 !py-2.5 !text-[15px] !font-bold shadow-[0px_4px_16px_0px_rgba(26,20,10,0.12)]"
            ) %>
          </span>
          <% if image_actions? %>
            <%= image_actions %>
          <% end %>
        </div>
      </div>

      <div class="<%= grid_card_body_classes %>">
        <% brand_row = capture do %>
        <div class="flex items-start gap-3"<% if show_brand_row? %> data-cover-brand<% end %>>
          <div class="flex min-w-0 flex-1 flex-col gap-[14px]">
            <% if company_name.present? %>
              <div class="flex min-w-0 items-center gap-1.5" data-cover-brand-name>
                <p class="truncate text-[13px] font-medium uppercase leading-[normal] tracking-[0.22em]" data-cover-company><%= company_name %></p>
                <span class="inline-flex shrink-0" data-cover-verification></span>
              </div>
            <% end %>

            <% if inline_edit? %>
              <%= render RecordingStudioPresskits::PressKits::HeaderInlineCopyComponent.new(
                recording: @recording,
                update_path: inline_path,
                heading: title_tag
              ) %>
            <% else %>
              <div class="flex flex-col gap-0.5">
                <%= content_tag title_tag, title, class: "text-[30px] font-bold leading-[38px] tracking-[-0.45px] text-balance", data: { cover_title: true } %>
                <% if subtitle.present? %>
                  <p class="text-[30px] font-normal leading-[38px] tracking-[-0.45px]" data-cover-subtitle><%= subtitle %></p>
                <% end %>
              </div>

              <% if description.present? %>
                <p class="line-clamp-3 text-base leading-6 text-[var(--surface-muted-content-color)]" data-cover-description><%= description %></p>
              <% end %>
            <% end %>

            <% if location_recordable %>
              <div class="flex items-center gap-2 text-sm" data-cover-location>
                <% if location_recordable.resolved_icon.present? %>
                  <%= render FlatPack::Shared::IconComponent.new(name: location_recordable.resolved_icon, size: :sm) %>
                <% end %>
                <span><%= location_recordable.display_name %></span>
              </div>
            <% end %>
          </div>
          <% if show_add_to_list? %>
            <div class="shrink-0" data-cover-list onclick="event.stopPropagation()">
              <%= helpers.recording_studio_add_to_list(
                @recording,
                text: "",
                icon: "heart",
                style: :ghost,
                size: :lg,
                show_chevron: false,
                placement: :bottom_right,
                parent: list_parent
              ) %>
            </div>
          <% end %>
        </div>
        <% end %>

        <% if body_actions? %>
          <%# Same row as a section: actions sit at the trailing edge, above the copy below sm. %>
          <div class="flex flex-col-reverse gap-4 sm:flex-row sm:items-start sm:justify-between">
            <div class="min-w-0 flex-1">
              <%= brand_row %>
            </div>
            <%= body_actions %>
          </div>
        <% else %>
          <%= brand_row %>
        <% end %>

        <% if href.present? %>
          <div class="mt-auto flex justify-end pb-8 pt-6">
            <%= render FlatPack::Button::Component.new(
              text: view_label,
              icon: "arrow-right",
              style: :primary,
              size: :lg,
              href: href,
              class: "rounded-full [&>svg]:order-last",
              data: { cover_view: true }
            ) %>
          </div>
        <% end %>
      </div>
    </div>
  <% end %>
<% end %>
