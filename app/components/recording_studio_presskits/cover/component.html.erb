<% if card? %>
  <div data-presskits-brand="true" style="display: contents; --color-primary: <%= brand_color %>; --color-primary-text: <%= brand_text_color %>; <%= button_state_style %>">
  <%= render FlatPack::Card::Component.new(
    style: :default,
    hover: :none,
    padding: :none,
    theme: view_button_theme,
    id: wrapper_id,
    class: grid_card_classes,
    data: grid_card_data
  ) do %>
    <%# Tailwind scans these literals: "@container" "@min-[640px]:flex-row" "@min-[640px]:min-h-[50cqw]" "@min-[640px]:aspect-auto" "@min-[640px]:w-1/2" "@min-[640px]:shrink-0" "@min-[640px]:self-stretch" "@min-[640px]:min-w-0" "@min-[640px]:pt-16" "@min-[640px]:top-18" "@min-[640px]:hidden" "@min-[640px]:contents" "hidden" "pr-16" "@min-[640px]:rounded-tr-none" "@min-[640px]:rounded-bl-[var(--radius-lg)]" "aspect-[430/368]" "flex flex-1 flex-col px-8 pt-7" "min-w-0 @min-[640px]:pt-16" "flex items-center gap-2" "flex w-full min-w-0 flex-col self-stretch" %>
    <div class="<%= grid_card_row_classes %>" style="<%= font_style %>" data-cover-row>
      <%= render FlatPack::Overlay::Component.new(class: grid_card_frame_classes, data: { cover_frame: true }) do |overlay| %>
        <% overlay.with_media do %>
          <% if cover_image? %>
            <div class="absolute inset-0 h-full w-full" data-cover-image>
              <%= image_tag cover_image_url, alt: cover_image_alt, class: "h-full w-full object-cover" %>
            </div>
          <% else %>
            <div class="absolute inset-0 h-full w-full bg-[var(--surface-muted-background-color)]" data-cover-fallback></div>
          <% end %>
        <% end %>
        <% overlay.with_item(placement: :top_left, inset: :md) do %>
          <%= render FlatPack::Badge::Component.new(
            text: eyebrow,
            size: :md,
            style: :default,
            data: { cover_tag: true, cover_eyebrow: true }
          ) %>
        <% end %>
        <% if body_actions? || image_actions? %>
          <% overlay.with_item(placement: :top_right, inset: :md) do %>
            <div class="flex items-center gap-2" data-cover-image-actions>
              <% if body_actions? %>
                <div class="@min-[640px]:hidden" data-cover-edit="stacked">
                  <%= body_actions %>
                </div>
              <% end %>
              <%= image_actions if image_actions? %>
            </div>
          <% end %>
        <% end %>
      <% end %>

      <% brand_row = capture do %>
        <div class="<%= grid_card_copy_classes %>" data-cover-copy<% if show_brand_row? %> data-cover-brand<% end %>>
          <div class="flex min-w-0 flex-col gap-[14px]">
            <% if company_name.present? %>
              <div class="flex min-w-0 items-center gap-1.5 <%= company_heart_clearance_classes %>" data-cover-brand-name>
                <p class="truncate text-[13px] font-medium uppercase leading-[normal] tracking-[0.22em]" data-cover-company><%= company_name %></p>
                <span class="inline-flex shrink-0" data-cover-verification></span>
              </div>
            <% end %>

            <% if inline_edit? %>
              <%= render RecordingStudioPresskits::PressKits::HeaderInlineCopyComponent.new(
                recording: @recording,
                update_path: inline_path,
                heading: title_tag
              ) %>
            <% else %>
              <div class="flex flex-col gap-0.5">
                <%= content_tag title_tag, title, class: "text-[30px] font-bold leading-[38px] tracking-[-0.45px] text-balance", data: { cover_title: true } %>
                <% if subtitle.present? %>
                  <p class="text-[30px] font-normal leading-[38px] tracking-[-0.45px]" data-cover-subtitle><%= subtitle %></p>
                <% end %>
              </div>

              <% if description.present? %>
                <p class="line-clamp-3 text-base leading-6 text-[var(--surface-muted-content-color)]" data-cover-description><%= description %></p>
              <% end %>
            <% end %>

            <% if location_recordable %>
              <div class="flex items-center gap-2 text-sm" data-cover-location>
                <% if location_recordable.resolved_icon.present? %>
                  <%= render FlatPack::Shared::IconComponent.new(name: location_recordable.resolved_icon, size: :sm) %>
                <% end %>
                <span><%= location_recordable.display_name %></span>
              </div>
            <% end %>
          </div>
        </div>
        <% end %>

        <% column = capture do %>
          <%= brand_row %>
          <% if href.present? %>
            <div class="mt-auto flex justify-end pb-8 pt-6">
              <%= render FlatPack::Button::Component.new(
                text: view_label,
                icon: "arrow-right",
                style: :primary,
                size: :lg,
                href: href,
                class: "rounded-full [&>svg]:order-last",
                data: { cover_view: true }
              ) %>
            </div>
          <% end %>
        <% end %>

        <% if body_actions? || show_add_to_list? %>
          <%= render FlatPack::Overlay::Component.new(class: grid_card_body_classes, data: { cover_body: true }) do |overlay| %>
            <% overlay.with_media do %>
              <div class="flex w-full min-w-0 flex-col self-stretch">
                <%= column %>
              </div>
            <% end %>
            <% if body_actions? %>
              <%# Wide Edit. inset lg is the overlay step nearest the old 29/33 inset. %>
              <% overlay.with_item(placement: :top_right, inset: :lg) do %>
                <div class="hidden @min-[640px]:contents" data-cover-edit="wide">
                  <%= body_actions %>
                </div>
              <% end %>
            <% end %>
            <% if show_add_to_list? %>
              <%# Stacked: body top-right (Edit is on the cover). Wide: top-18 lines the heart up with the company line, below Edit. %>
              <% overlay.with_item(placement: :top_right, inset: :sm, class: "@min-[640px]:top-18", data: { cover_heart: true }) do %>
                <div class="shrink-0" data-cover-list onclick="event.stopPropagation()">
                  <%= helpers.recording_studio_add_to_list(
                    @recording,
                    text: "",
                    icon: "heart",
                    style: :ghost,
                    size: :lg,
                    show_chevron: false,
                    placement: :bottom_right,
                    parent: list_parent
                  ) %>
                </div>
              <% end %>
            <% end %>
          <% end %>
        <% else %>
          <div class="<%= grid_card_body_classes %>" data-cover-body>
            <%= column %>
          </div>
        <% end %>
    </div>
  <% end %>
  </div>
<% end %>
