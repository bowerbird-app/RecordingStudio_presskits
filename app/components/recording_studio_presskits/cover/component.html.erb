<% if hero? %>
  <div
    id="<%= wrapper_id %>"
    class="<%= surface_classes %>"
    style="<%= surface_style %>"
    data-cover-color="<%= cover_color %>"
    data-cover-text-color="<%= text_color %>"
    data-cover-style="<%= cover_style %>"
    data-cover-ratio="<%= cover_ratio %>"
    data-recording-studio-presskits--cover-preview-target="surface"
  >
    <div class="<%= hero_copy_classes %>">
      <p class="<%= eyebrow_classes %>" style="<%= eyebrow_style %>" data-cover-eyebrow><%= eyebrow %></p>
      <%= render FlatPack::PageTitle::Component.new(
        title: title,
        variant: heading_variant,
        title_color: text_color,
        class: "mb-0"
      ) %>
    </div>
  </div>
<% else %>
  <%= render FlatPack::Card::Component.new(
    style: card_style,
    clickable: href.present?,
    href: href,
    padding: :none,
    theme: { background: cover_color, text: text_color },
    id: wrapper_id,
    class: wrapper_classes
  ) do |card| %>
    <% card.body do %>
      <div
        class="<%= surface_classes %>"
        style="<%= surface_style %>"
        data-cover-color="<%= cover_color %>"
        data-cover-text-color="<%= text_color %>"
        data-cover-style="<%= cover_style %>"
        data-cover-ratio="<%= cover_ratio %>"
        data-recording-studio-presskits--cover-preview-target="surface"
      >
        <% if card? %>
          <h1 class="font-bold leading-tight tracking-tight text-balance" style="font-size: var(--page-title-h1-size); color: <%= text_color %>;">
            <%= title %>
          </h1>
          <% if description.present? %>
            <p class="mt-2 line-clamp-2 text-base text-pretty" style="color: <%= text_color %>;"><%= description %></p>
          <% end %>
        <% else %>
          <%= render FlatPack::PageTitle::Component.new(
            title: title,
            subtitle: description,
            variant: heading_variant,
            title_color: text_color,
            subtitle_color: text_color
          ) %>
        <% end %>
      </div>
    <% end %>
  <% end %>
<% end %>
