<div class="flex w-full flex-col gap-6">
  <% if image_recordings.any? %>
    <%= render FlatPack::Grid::Component.new(cols: 2, gap: :md) do %>
      <% image_recordings.each do |image_recording| %>
        <% url = image_url_for(image_recording) %>
        <figure class="flex flex-col gap-2">
          <% if url.present? %>
            <%= image_tag url,
                  alt: image_recording.recordable.name,
                  class: "aspect-video w-full rounded-lg object-cover" %>
          <% end %>
          <div>
            <%= render FlatPack::Button::Component.new(
              icon: "trash",
              icon_only: true,
              style: :ghost,
              size: :sm,
              href: remove_path_for(image_recording),
              data: { turbo_method: :delete },
              aria: { label: "Remove image" }
            ) %>
          </div>
        </figure>
      <% end %>
    <% end %>
  <% end %>

  <%= render FlatPack::TextInput::Component.new(
    name: "images[caption]",
    value: @images.caption,
    label: "Caption",
    class: "w-full"
  ) %>

  <div
    data-controller="recording-studio-attachable--upload"
    data-recording-studio-attachable--upload-direct-upload-url-value="<%= direct_upload_url %>"
    data-recording-studio-attachable--upload-finalize-url-value="<%= upload_url %>"
    data-recording-studio-attachable--upload-max-file-size-value="<%= max_file_size %>"
    data-recording-studio-attachable--upload-max-files-count-value="<%= max_file_count %>"
    data-recording-studio-attachable--upload-allowed-content-types-value="<%= allowed_content_types %>"
    data-recording-studio-attachable--upload-remove-button-template-value="<%= remove_button_template %>">
    <template data-recording-studio-attachable--upload-target="progressTemplate">
      <%= render FlatPack::Progress::Component.new(value: 0, max: 100, label: "Progress") %>
    </template>

    <div
      class="flex min-h-40 flex-col items-center justify-center gap-4 rounded-xl border border-dashed border-(--surface-border-color) p-8 text-center"
      data-recording-studio-attachable--upload-target="dropzone">
      <p class="text-sm text-(--surface-muted-content-color)">Drag images here, or choose files</p>
      <input
        type="file"
        multiple
        accept="image/*"
        class="hidden"
        data-recording-studio-attachable--upload-target="input"
        data-action="change->recording-studio-attachable--upload#filesSelected">
      <%= render FlatPack::Button::Component.new(
        text: "Choose images",
        style: :primary,
        size: :md,
        type: "button",
        icon: "upload",
        data: { action: "recording-studio-attachable--upload#browse" }
      ) %>
    </div>

    <div class="hidden space-y-4" data-recording-studio-attachable--upload-target="queue"></div>
  </div>
</div>
