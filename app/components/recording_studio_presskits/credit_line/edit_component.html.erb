<div class="flex max-w-xl flex-col gap-6">
  <% unless helpers.presskits_editor_dialog? %>
    <%= render FlatPack::PageTitle::Component.new(title: credit_name, variant: :h1) %>
  <% end %>

  <% if credit_edit_path %>
    <%= render FlatPack::Button::Component.new(text: "Edit credit", style: :secondary, href: credit_edit_path, data: helpers.presskits_editor_nav(:push)) %>
  <% end %>

  <%= form_with url: update_path, method: :patch, local: true, class: "flex flex-col gap-4", data: helpers.presskits_editor_save_data do %>
    <%= hidden_field_tag :from_kit_editor, "1" if helpers.presskits_editor_dialog? %>
    <%= render FlatPack::Button::Component.new(text: "Save", style: :primary, type: "submit") %>
    <%= render FlatPack::Button::Component.new(text: "Cancel", style: :default, href: cancel_path, data: helpers.presskits_editor_nav(:back)) %>

    <%= render FlatPack::TextInput::Component.new(
      name: "credit_line[role]",
      label: "Role on this kit",
      value: line.role,
      class: "w-full"
    ) %>
  <% end %>
</div>
