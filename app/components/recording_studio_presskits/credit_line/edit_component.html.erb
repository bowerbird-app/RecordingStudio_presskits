<div class="flex max-w-xl flex-col gap-6">
  <%= render FlatPack::PageTitle::Component.new(title: credit_name, variant: :h1) %>

  <% if credit_edit_path %>
    <%= render FlatPack::Button::Component.new(text: "Edit credit", style: :secondary, href: credit_edit_path) %>
  <% end %>

  <%= form_with url: update_path, method: :patch, local: true, class: "flex flex-col gap-4" do %>
    <%= render FlatPack::Button::Component.new(text: "Save", style: :primary, type: "submit") %>
    <%= render FlatPack::Button::Component.new(text: "Cancel", style: :default, href: cancel_path) %>

    <%= render FlatPack::TextInput::Component.new(
      name: "credit_line[role]",
      label: "Role",
      value: line.role,
      help_text: "This kit only.",
      class: "w-full"
    ) %>
  <% end %>
</div>
