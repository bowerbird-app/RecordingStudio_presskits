<%= form_with url: @update_path, method: :patch, local: true, class: "flex w-full flex-col items-start gap-4" do %>
  <%= render FlatPack::TextArea::Component.new(
    name: "text[body]",
    label: "Text",
    value: @text.body,
    required: true,
    class: "w-full",
    rich_text: true,
    rich_text_options: {
      preset: :content,
      toolbar: :standard,
      character_count: true
    }
  ) %>

  <%= render FlatPack::Button::Component.new(text: "Save", style: :primary, type: "submit") %>
<% end %>
