<div class="flex flex-col gap-4">
  <% if section_title.present? %>
    <div id="presskits-text-title">
      <%= render FlatPack::PageTitle::Component.new(title: section_title, variant: :h2) %>
    </div>
  <% end %>

  <div class="flat-pack-richtext--view-mode">
    <div class="flat-pack-richtext-editor">
      <div class="ProseMirror">
        <%= body_html %>
      </div>
    </div>
  </div>
</div>
