<div class="flex w-full flex-col gap-6">
  <%= form_with url: update_path, method: :patch, local: true,
        id: "presskits-facts-display-form",
        class: "flex flex-col gap-6",
        data: {
          controller: "recording-studio-presskits--facts-display flat-pack--unsaved-changes",
          action: "change->recording-studio-presskits--facts-display#toggle"
        } do %>
    <%= render FlatPack::Select::Component.new(
      name: "facts_section[display_style]",
      value: section.display_style,
      label: "Show as",
      options: display_style_options,
      class: "w-full"
    ) %>

    <div
      data-recording-studio-presskits--facts-display-target="columns"
      <%= "hidden" unless section.cards? %>
    >
      <%= render FlatPack::Select::Component.new(
        name: "facts_section[columns]",
        value: section.columns,
        label: "Columns",
        options: column_options,
        disabled: !section.cards?,
        class: "w-full"
      ) %>
    </div>

    <div id="presskits-facts-display-update" class="flex flex-wrap items-center gap-3">
      <%= render FlatPack::Button::Component.new(
        text: "Update",
        style: :default,
        type: "submit",
        data: { "flat-pack--unsaved-changes-target": "submit" }
      ) %>
    </div>
  <% end %>

  <% if facts.any? %>
    <div
      id="presskits-fact-list"
      data-controller="recording-studio-presskits--section-order"
      data-action="list:reordered->recording-studio-presskits--section-order#save"
      data-recording-studio-presskits--section-order-url-value="<%= order_path %>"
    >
      <%= render FlatPack::Card::Component.new(style: :default, class: "w-full") do %>
        <%= render FlatPack::List::Component.new(orderable: true, divider: true, class: "w-full") do %>
          <% facts.each do |fact_recording| %>
            <%= render FlatPack::List::Item.new(id: fact_recording.id, icon: "arrows-up-down", hover: true) do %>
              <div class="flex w-full items-center justify-between gap-3">
                <div class="min-w-0 flex-1">
                  <%= link_to edit_path(fact_recording), draggable: "false", class: "block min-w-0" do %>
                    <span class="block truncate text-sm font-medium text-(--surface-content-color)">
                      <%= fact_label(fact_recording) %>
                    </span>
                    <% if (summary = fact_summary(fact_recording)) %>
                      <span class="block truncate text-sm text-(--surface-muted-content-color)">
                        <%= summary %>
                      </span>
                    <% end %>
                  <% end %>
                </div>
                <%= form_with url: remove_path(fact_recording), method: :delete, local: true, html: { draggable: "false" } do %>
                  <%= render FlatPack::Button::Component.new(
                    icon: "trash",
                    icon_only: true,
                    style: :ghost,
                    size: :sm,
                    type: "submit",
                    draggable: "false",
                    aria: { label: "Remove fact" }
                  ) %>
                <% end %>
              </div>
            <% end %>
          <% end %>
        <% end %>
      <% end %>
    </div>
  <% else %>
    <%= render FlatPack::EmptyState::Component.new(
      title: "No figures yet",
      description: "Add a number, a date, or a short line.",
      icon: :inbox
    ) do |empty| %>
      <% empty.with_actions do %>
        <%= render FlatPack::Button::Component.new(text: "Fact", icon: "plus", style: :primary, href: add_path) %>
      <% end %>
    <% end %>
  <% end %>
</div>
