<div class="flex w-full flex-col gap-6">
  <%= render FlatPack::PageTitle::Component.new(
    title: "Credits",
    subtitle: "People and studios you can drop into any kit.",
    variant: :h1
  ) %>

  <%= render FlatPack::Button::Component.new(
    text: "Credit",
    icon: "plus",
    style: :primary,
    href: @new_path
  ) %>

  <% if rows.empty? %>
    <%= render FlatPack::EmptyState::Component.new(
      title: "Nobody to credit yet",
      description: "Add a person or studio once, then use them on any kit.",
      icon: :inbox
    ) %>
  <% else %>
    <%= render FlatPack::Table::Component.new(data: rows) do |table| %>
      <% table.column(title: "Name", html: ->(recording) { helpers.link_to(recording.recordable.name, edit_href(recording)) }) %>
      <% table.column(title: "Usual role", html: ->(recording) { usual_role(recording) }) %>
      <% table.column(title: "URL", html: ->(recording) { url_cell(recording) }) %>
    <% end %>
  <% end %>
</div>
