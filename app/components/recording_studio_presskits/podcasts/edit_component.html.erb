<div class="flex flex-col gap-6">
  <% unless helpers.presskits_editor_dialog? %>
    <%= render FlatPack::PageTitle::Component.new(title: heading, variant: :h1) %>
  <% end %>

  <% if podcast.errors.any? %>
    <%= render FlatPack::Alert::Component.new(description: podcast.errors.full_messages.to_sentence, style: :danger) %>
  <% end %>

  <%= form_with url: form_path, method: form_method, local: true, class: "flex flex-col gap-6", data: form_data do %>
    <%= hidden_field_tag :from_kit_editor, "1" if helpers.presskits_editor_dialog? %>
    <div class="flex flex-wrap items-center gap-3">
      <%= render FlatPack::Button::Component.new(text: "Save", style: :primary, type: "submit") %>
      <%= render FlatPack::Button::Component.new(text: "Cancel", style: :default, href: cancel_path, data: helpers.presskits_editor_nav(:back)) %>
      <% if persisted? %>
        <%= render FlatPack::Button::Component.new(
          text: "Upload",
          icon: "upload",
          style: :default,
          type: "button",
          data: { action: "recording-studio-attachable--upload#browse" }
        ) %>
      <% end %>
    </div>

    <% if cover_url.present? %>
      <div class="flex items-center gap-3">
        <%= image_tag cover_url, alt: heading, class: "h-16 w-16 rounded-[var(--radius-md)] object-cover" %>
        <% if uploaded_cover? %>
          <%= render FlatPack::Button::Component.new(
            icon: "trash",
            icon_only: true,
            style: :ghost,
            size: :sm,
            href: image_path,
            method: :delete,
            aria: { label: "Remove cover" }
          ) %>
        <% end %>
      </div>
    <% end %>

    <%= render FlatPack::TextInput::Component.new(
      name: "podcast[url]",
      value: podcast.url,
      label: "Link",
      placeholder: "https://",
      required: true,
      class: "w-full"
    ) %>
    <%= render FlatPack::TextInput::Component.new(
      name: "podcast[title]",
      value: podcast.title,
      label: "Episode title",
      class: "w-full"
    ) %>
    <%= render FlatPack::TextInput::Component.new(
      name: "podcast[show_name]",
      value: podcast.show_name,
      label: "Show",
      class: "w-full"
    ) %>
    <%= render FlatPack::TextInput::Component.new(
      name: "podcast[aired_on]",
      value: aired_on_value,
      label: "Date",
      type: "date",
      class: "w-full"
    ) %>
    <%= render FlatPack::TextInput::Component.new(
      name: "podcast[duration]",
      value: podcast.duration,
      label: "Duration",
      placeholder: "34 min",
      class: "w-full"
    ) %>

    <% if persisted? %>
      <div class="hidden" data-recording-studio-attachable--upload-target="dropzone"></div>
      <input
        type="file"
        accept="image/*"
        class="hidden"
        data-recording-studio-attachable--upload-target="input"
        data-action="change->recording-studio-attachable--upload#filesSelected">
      <template data-recording-studio-attachable--upload-target="progressTemplate">
        <%= render FlatPack::Progress::Component.new(value: 0, max: 100, label: "Progress") %>
      </template>
      <div class="hidden space-y-4" data-recording-studio-attachable--upload-target="queue"></div>
    <% end %>
  <% end %>
</div>
