<% if videos.any? %>
  <div class="flex w-full flex-col gap-8">
    <%= render RecordingStudioPresskits::VideoSection::CardComponent.new(video_recording: videos.first, featured: true) %>
    <% if videos.drop(1).any? %>
      <%= render FlatPack::Grid::Component.new(cols: 2, gap: :lg, align: :start, class: "w-full", data: { presskits_video_grid: true }) do %>
        <% videos.drop(1).each do |video_recording| %>
          <%= render RecordingStudioPresskits::VideoSection::CardComponent.new(video_recording: video_recording) %>
        <% end %>
      <% end %>
    <% end %>
  </div>
<% end %>
