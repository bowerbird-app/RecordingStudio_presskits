<% if stats.any? %>
  <%= render FlatPack::Grid::Component.new(cols: 3, gap: :lg) do %>
    <% stats.each do |stat_recording| %>
      <% stat = stat_recording.recordable %>
      <%= render FlatPack::Card::Component.new(style: :default, class: "w-full") do %>
        <div class="text-center">
          <% if (icon = stat.icon.to_s.strip.presence) %>
            <%= render FlatPack::Shared::IconComponent.new(
              name: icon,
              size: :xl,
              class: "mx-auto mb-2 text-(--surface-content-color)"
            ) %>
          <% end %>
          <p class="fp-tabular-nums text-(--surface-content-color)">
            <span class="text-4xl font-bold"><%= stat.value %></span>
            <% if (unit = stat.unit.to_s.strip.presence) %>
              <span class="text-xl font-medium"><%= " #{unit}" %></span>
            <% end %>
          </p>
          <p class="mt-2 text-lg font-semibold text-(--surface-content-color) fp-text-balance"><%= stat.label %></p>
          <% if (description = stat.description.to_s.strip.presence) %>
            <p class="mt-2 text-sm text-(--surface-muted-content-color) fp-text-pretty"><%= description %></p>
          <% end %>
        </div>
      <% end %>
    <% end %>
  <% end %>
<% end %>
