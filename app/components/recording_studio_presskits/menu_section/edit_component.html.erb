<div class="flex w-full flex-col gap-6">
  <%= render FlatPack::RadioGroup::Component.new(
    name: "menu_section[layout]",
    label: "Layout",
    value: @menu.layout,
    options: layout_options,
    help_text: "Grid wraps across the page. List keeps one column."
  ) %>

  <%= hidden_field_tag "menu_section[show_counts]", "0" %>
  <%= render FlatPack::Switch::Component.new(
    name: "menu_section[show_counts]",
    label: "Show counts",
    checked: @menu.show_counts?,
    help_text: "A number on photos, videos, and files."
  ) %>

  <%= hidden_field_tag "menu_section[show_icons]", "0" %>
  <%= render FlatPack::Switch::Component.new(
    name: "menu_section[show_icons]",
    label: "Show icons",
    checked: @menu.show_icons?,
    help_text: "The section icon beside the name."
  ) %>

  <% if exclusion_candidates.any? %>
    <%= hidden_field_tag "menu_section[excluded_section_ids][]", "" %>
    <%= render FlatPack::Fieldset::Component.new(
      title: "Leave these out",
      description: "They stay in the kit."
    ) do %>
      <% exclusion_candidates.each do |section| %>
        <%= render FlatPack::Checkbox::Component.new(
          name: "menu_section[excluded_section_ids][]",
          value: section.id,
          checked: excluded?(section),
          label: heading_for(section)
        ) %>
      <% end %>
    <% end %>
  <% end %>
</div>
