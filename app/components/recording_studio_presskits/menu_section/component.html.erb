<% if entries.any? %>
  <nav aria-labelledby="<%= heading_anchor_id %>" data-presskits-menu>
    <ul class="<%= list_classes %>">
      <% entries.each do |entry| %>
        <li class="<%= item_classes %>">
          <%= render entry.button %>
          <% if entry.badge %>
            <%= render entry.badge %>
          <% end %>
        </li>
      <% end %>
    </ul>
  </nav>
<% end %>
