<% if quotes.any? %>
  <div class="flex flex-col gap-6">
    <% quotes.each do |quote_recording| %>
      <% quote = quote_recording.recordable %>
      <%= render FlatPack::Quote::Component.new(
        text: quote.body.to_s.strip,
        cite: cite(quote).presence,
        size: :lg,
        class: quote_frame_classes
      ) %>
    <% end %>
  </div>
<% end %>
