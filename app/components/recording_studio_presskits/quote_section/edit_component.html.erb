<div class="flex w-full flex-col gap-6">
  <div id="presskits-section-actions" class="flex flex-wrap items-center gap-3">
    <%= form_with url: add_path, method: :post, local: true, class: "inline-flex" do %>
      <%= render FlatPack::Button::Component.new(text: "Add quote", style: :primary, type: "submit") %>
    <% end %>
    <%= render FlatPack::Button::Component.new(text: "Cancel", style: :default, href: cancel_path) %>
  </div>

  <% if quotes.any? %>
    <div
      data-controller="recording-studio-presskits--section-order"
      data-action="list:reordered->recording-studio-presskits--section-order#save"
      data-recording-studio-presskits--section-order-url-value="<%= order_path %>"
    >
      <%= render FlatPack::List::Component.new(orderable: true, divider: true, class: "w-full") do %>
        <% quotes.each do |quote_recording| %>
          <%= render FlatPack::List::Item.new(id: quote_recording.id, icon: "arrows-up-down") do %>
            <%= form_with url: quote_path(quote_recording), method: :patch, local: true,
                  html: { draggable: "false" }, data: upload_data_for(quote_recording) do %>
              <% quote = quote_recording.recordable %>
              <div class="flex w-full flex-col gap-4">
                <% url = avatar_url(quote_recording) %>
                <% if url.present? %>
                  <div class="flex items-center gap-3">
                    <%= image_tag url, alt: avatar_alt(quote_recording), class: "h-10 w-10 rounded object-cover" %>
                    <%= render FlatPack::Button::Component.new(
                      icon: "trash",
                      icon_only: true,
                      style: :ghost,
                      size: :sm,
                      href: image_path(quote_recording),
                      data: { turbo_method: :delete },
                      aria: { label: "Remove image" }
                    ) %>
                  </div>
                <% end %>

                <%= render FlatPack::TextArea::Component.new(
                  name: "quote[body]",
                  value: quote.body,
                  label: "Quote",
                  class: "w-full"
                ) %>
                <%= render FlatPack::TextInput::Component.new(
                  name: "quote[name]",
                  value: quote.name,
                  label: "Name",
                  class: "w-full"
                ) %>
                <%= render FlatPack::TextInput::Component.new(
                  name: "quote[role]",
                  value: quote.role,
                  label: "Role",
                  class: "w-full"
                ) %>
                <%= render FlatPack::TextInput::Component.new(
                  name: "quote[organisation]",
                  value: quote.organisation,
                  label: "Organisation",
                  class: "w-full"
                ) %>

                <div class="hidden" data-recording-studio-attachable--upload-target="dropzone"></div>
                <input
                  type="file"
                  accept="image/*"
                  class="hidden"
                  data-recording-studio-attachable--upload-target="input"
                  data-action="change->recording-studio-attachable--upload#filesSelected">
                <template data-recording-studio-attachable--upload-target="progressTemplate">
                  <%= render FlatPack::Progress::Component.new(value: 0, max: 100, label: "Progress") %>
                </template>
                <div class="hidden space-y-4" data-recording-studio-attachable--upload-target="queue"></div>

                <div class="flex flex-wrap items-center gap-3">
                  <%= render FlatPack::Button::Component.new(text: "Save", style: :primary, type: "submit") %>
                  <%= render FlatPack::Button::Component.new(
                    icon: "trash",
                    icon_only: true,
                    style: :ghost,
                    size: :sm,
                    href: quote_path(quote_recording),
                    data: { turbo_method: :delete },
                    aria: { label: "Remove quote" }
                  ) %>
                  <%= render FlatPack::Button::Component.new(
                    text: "Upload",
                    icon: "upload",
                    style: :default,
                    type: "button",
                    data: { action: "recording-studio-attachable--upload#browse" }
                  ) %>
                </div>
              </div>
            <% end %>
          <% end %>
        <% end %>
      <% end %>
    </div>
  <% end %>
</div>
