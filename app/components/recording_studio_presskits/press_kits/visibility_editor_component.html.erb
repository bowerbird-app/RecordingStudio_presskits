<div
  class="flex flex-col gap-6"
  data-controller="recording-studio-presskits--visibility-fallback"
  data-recording-studio-presskits--visibility-fallback-public-value="public"
  data-action="change->recording-studio-presskits--visibility-fallback#sync"
>
  <%= form_with url: helpers.press_kit_visibility_path(@press_kit_recording), method: :patch,
        id: "presskits-visibility-form",
        class: "flex flex-col gap-6",
        data: helpers.presskits_editor_save_data.merge(controller: "flat-pack--unsaved-changes") do %>
    <%= hidden_field_tag :from_kit_editor, "1" if helpers.presskits_editor_dialog? %>

    <% if constrained? %>
      <%= render FlatPack::Alert::Component.new(
        description: I18n.t("recording_studio_presskits.visibility.constrained"),
        style: :info
      ) %>
    <% end %>

    <%= render FlatPack::Select::Component.new(
      name: "visibility[audience]",
      label: I18n.t("recording_studio_presskits.visibility.audience_label"),
      value: audience_value,
      options: select_options,
      required: true
    ) %>

    <div
      data-recording-studio-presskits--visibility-fallback-target="fallback"
      <% if public_audience? %>hidden<% end %>
    >
      <%= render FlatPack::RadioGroup::Component.new(
        name: "visibility[visibility_fallback]",
        label: I18n.t("recording_studio_presskits.visibility.fallback_label"),
        value: fallback_value,
        variant: :cards,
        options: fallback_options
      ) %>
    </div>

    <div id="presskits-visibility-actions" class="flex flex-wrap items-center gap-3">
      <%= render FlatPack::Button::Component.new(
        text: I18n.t("recording_studio_presskits.visibility.save"),
        style: :default,
        type: "submit",
        data: { "flat-pack--unsaved-changes-target": "submit" }
      ) %>
    </div>
  <% end %>
</div>
