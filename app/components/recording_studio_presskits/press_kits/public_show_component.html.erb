<div class="flex w-full flex-col gap-6">
  <%= render FlatPack::PageTitle::Component.new(
    title: kit_title,
    variant: :h1
  ) %>

  <% if preview? && !live? %>
    <%= render FlatPack::Alert::Component.new(
      description: "This is just for you. Nobody else can see it yet.",
      style: :info
    ) %>
  <% end %>

  <% if section_recordings.empty? %>
    <%= render FlatPack::EmptyState::Component.new(
      title: "Nothing to show yet",
      description: "Sections will land here once they add some.",
      icon: :inbox
    ) %>
  <% else %>
    <% section_recordings.each_with_index do |recording, index| %>
      <% if index.positive? %>
        <%= render FlatPack::Divider::Component.new %>
      <% end %>
      <% if (title = section_title(recording)).present? %>
        <%= render FlatPack::SectionTitle::Component.new(title: title) %>
      <% end %>
      <% component = section_component_for(recording) %>
      <% if component %>
        <%= render component.new(recording: recording) %>
      <% end %>
    <% end %>
  <% end %>
</div>
