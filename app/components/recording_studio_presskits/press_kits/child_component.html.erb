<%= render FlatPack::List::Item.new(id: @recording.id, icon: row_icon, hover: true, class: "!items-center") do %>
  <div class="flex w-full flex-wrap items-center justify-between gap-3">
    <div class="min-w-0 flex-1">
      <%= link_to row_label, @edit_path, draggable: "false", title: link_title, class: "block min-w-0 truncate text-sm font-medium text-(--surface-content-color)" %>
    </div>

    <% if can_remove? %>
      <%= form_with url: @remove_path, method: :delete, local: true, html: { draggable: "false" } do %>
        <%= render FlatPack::Button::Component.new(
          icon: "trash",
          icon_only: true,
          style: :ghost,
          size: :sm,
          type: "submit",
          draggable: "false",
          aria: { label: "Remove" }
        ) %>
      <% end %>
    <% end %>
  </div>
<% end %>
