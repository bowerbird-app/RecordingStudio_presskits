<%= render FlatPack::List::Item.new(icon: "arrows-up-down", hover: true) do %>
  <div class="flex w-full flex-wrap items-center justify-between gap-3">
    <div class="min-w-0 flex-1">
      <%= link_to row_label, @edit_path, draggable: "false", class: "text-sm font-medium text-(--surface-content-color)" %>
    </div>

    <% if can_remove? %>
      <%= form_with url: @remove_path, method: :delete, local: true, html: { draggable: "false" } do %>
        <%= render FlatPack::Button::Component.new(text: "Remove", style: :ghost, size: :sm, type: "submit", draggable: "false") %>
      <% end %>
    <% end %>
  </div>
<% end %>
