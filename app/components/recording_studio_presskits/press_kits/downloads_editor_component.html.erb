<div id="presskits-downloads-editor" class="flex flex-col gap-6 max-w-xl">
  <%= form_with url: helpers.press_kit_downloads_path(@press_kit_recording), method: :patch,
        id: "presskits-downloads-form",
        class: "flex flex-col gap-6",
        data: helpers.presskits_editor_save_data.merge(controller: "flat-pack--unsaved-changes") do %>
    <%= hidden_field_tag :from_kit_editor, "1" if helpers.presskits_editor_dialog? %>

    <% if constrained? %>
      <%= render FlatPack::Alert::Component.new(
        description: I18n.t("recording_studio_presskits.downloads.constrained"),
        style: :info
      ) %>
    <% end %>

    <div
      id="presskits-downloads-audience"
      role="group"
      aria-label="<%= I18n.t("recording_studio_presskits.downloads.audience_label") %>"
    >
      <%= render FlatPack::RadioGroup::Component.new(
        name: "downloads[audience]",
        value: audience_value,
        options: radio_options,
        variant: :inline,
        required: true
      ) %>
    </div>

    <div id="presskits-downloads-actions" class="flex flex-wrap items-center gap-3">
      <%= render FlatPack::Button::Component.new(
        text: I18n.t("recording_studio_presskits.downloads.save"),
        style: :default,
        type: "submit",
        data: { "flat-pack--unsaved-changes-target": "submit" }
      ) %>
    </div>
  <% end %>
</div>
