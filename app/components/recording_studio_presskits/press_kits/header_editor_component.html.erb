<div class="flex flex-col gap-6">
  <%= form_with url: helpers.press_kit_header_path(@press_kit_recording), method: :patch,
        id: "presskits-header-form",
        html: { style: "display: contents" },
        data: helpers.presskits_editor_save_data.merge(controller: "flat-pack--unsaved-changes") do %>
    <%= hidden_field_tag :from_kit_editor, "1" if helpers.presskits_editor_dialog? %>

    <div id="presskits-header-location" class="order-1 flex flex-col gap-6">
    <%= fields_for :location, header_location do |location_form| %>
      <%= helpers.recording_studio_location_search_fields(location_form) %>
    <% end %>
    </div>

    <div class="order-3 flex flex-col gap-6">
    <div
      id="presskits-header-brand"
      <% if inherit_available? %>
        data-controller="recording-studio-presskits--kit-brand"
        data-action="click->recording-studio-presskits--kit-brand#chooseSource"
      <% end %>
    >
      <%= render FlatPack::FormField::Component.new(
        field_id: "press_kit_font_family",
        label: "Brand"
      ) do |field| %>
        <% field.with_control do %>
          <% if inherit_available? %>
            <%= hidden_field_tag "press_kit[brand_source]", brand_source_value,
                  id: "press_kit_brand_source",
                  data: { recording_studio_presskits__kit_brand_target: "source" } %>
            <%= render FlatPack::Tabs::Component.new(default_tab: default_tab, variant: :pills, size: :md) do |tabs| %>
              <% tabs.tab(label: "Press center", id: "presskits-brand-press-center") do %>
                <p data-presskits-brand-inherited><%= press_center_summary %></p>
              <% end %>
              <% tabs.tab(label: "Custom", id: "presskits-brand-custom") do %>
                <%= render "recording_studio_presskits/press_kits/brand_swatches", editor: self %>
              <% end %>
            <% end %>
          <% else %>
            <%= render "recording_studio_presskits/press_kits/brand_swatches", editor: self %>
          <% end %>
        <% end %>
      <% end %>
    </div>

    <div id="presskits-header-actions" class="flex flex-wrap items-center gap-3">
      <%= render FlatPack::Button::Component.new(
        text: "Update",
        style: :default,
        type: "submit",
        data: { "flat-pack--unsaved-changes-target": "submit" }
      ) %>
    </div>
    </div>
  <% end %>

  <% if cover_controls.cover_image_enabled? %>
    <div id="press_kit_cover_image" class="order-2 flex flex-col gap-3">
      <%= render FlatPack::FormField::Component.new(
        field_id: "press_kit_cover_image_control",
        label: cover_controls.cover_image_label
      ) do |field| %>
        <% field.with_control do %>
          <div class="flex flex-wrap items-center gap-3">
            <%= helpers.render partial: "recording_studio_attachable/attachment_file_buttons/button",
                  locals: cover_controls.cover_file_button_locals %>
            <% if cover_controls.cover_attachment_recording %>
              <%= render FlatPack::Button::Component.new(
                text: I18n.t("recording_studio_presskits.editor.remove_cover_image"),
                style: :secondary,
                href: cover_controls.cover_remove_path,
                data: cover_controls.cover_remove_data
              ) %>
            <% end %>
          </div>
        <% end %>
      <% end %>
    </div>
  <% end %>
</div>
