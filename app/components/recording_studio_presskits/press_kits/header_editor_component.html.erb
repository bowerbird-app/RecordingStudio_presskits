<%= form_with url: helpers.press_kit_header_path(@press_kit_recording), method: :patch,
      id: "presskits-header-form",
      class: "flex flex-col gap-6",
      data: { controller: "flat-pack--unsaved-changes" } do %>
  <%= hidden_field_tag :from_kit_editor, "1" if helpers.presskits_editor_dialog? %>
  <%= render FlatPack::TextInput::Component.new(
    name: "press_kit[title]",
    label: "Title",
    value: header_title,
    required: true
  ) %>
  <%= render FlatPack::TextArea::Component.new(
    name: "press_kit[description]",
    label: "Short description",
    value: header_description,
    placeholder: "One or two lines for the people who open this.",
    character_count: true,
    max_characters: RecordingStudioPresskits::PressKit::SHORT_DESCRIPTION_LIMIT,
    class: "w-full"
  ) %>
  <div id="presskits-header-actions" class="flex flex-wrap items-center gap-3">
    <%= render FlatPack::Button::Component.new(
      text: "Update",
      style: :default,
      type: "submit",
      data: { "flat-pack--unsaved-changes-target": "submit" }
    ) %>
  </div>
<% end %>
