<div class="flex flex-col gap-6">
  <%= render FlatPack::PageTitle::Component.new(title: "Header", variant: :h1) %>

  <%= form_with url: helpers.press_kit_header_path(@press_kit_recording), method: :patch, local: true,
        class: "flex flex-col gap-6" do %>
    <div id="presskits-header-actions" class="flex flex-wrap items-center gap-3">
      <%= render FlatPack::Button::Component.new(text: "Update", style: :primary, type: "submit") %>
      <%= render FlatPack::Button::Component.new(text: "Cancel", style: :default, href: cancel_path) %>
    </div>

    <%= render FlatPack::Grid::Component.new(cols: 2, gap: :lg, align: :start) do %>
      <div class="flex w-full min-w-0 flex-col gap-6">
        <%= render FlatPack::TextInput::Component.new(
          name: "press_kit[title]",
          label: "Title",
          value: header_title,
          required: true
        ) %>
        <%= render FlatPack::TextArea::Component.new(
          name: "press_kit[description]",
          label: "Short description",
          value: header_description,
          placeholder: "One or two lines for the people who open this.",
          character_count: true,
          max_characters: RecordingStudioPresskits::PressKit::SHORT_DESCRIPTION_LIMIT,
          class: "w-full"
        ) %>
      </div>

      <div class="min-w-0">
        <%= render FlatPack::Card::Component.new(style: :default, id: "presskits-header-edit-preview", class: "w-full") do %>
          <% if header_title.present? %>
            <%= render FlatPack::PageTitle::Component.new(
              title: header_title,
              subtitle: header_description.presence,
              variant: :h2
            ) %>
          <% elsif header_description.present? %>
            <p class="text-sm font-medium text-(--surface-content-color)"><%= header_description %></p>
          <% end %>
        <% end %>
      </div>
    <% end %>
  <% end %>
</div>
