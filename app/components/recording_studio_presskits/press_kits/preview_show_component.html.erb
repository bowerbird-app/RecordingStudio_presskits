<div id="presskits-public-preview" class="<%= RecordingStudioPresskits::PressKits::EditorChrome::PREVIEW_CLASSES %>" data-presskits-presentation="preview" data-presskits-brand="true" style="<%= branding_style %>">
  <%= render FlatPack::Card::Component.new(
    style: :default,
    class: RecordingStudioPresskits::PressKits::EditorChrome::KIT_CARD_CLASSES,
    padding: :none
  ) do %>
    <%= render RecordingStudioPresskits::Cover::Component.new(
      recording: @press_kit_recording,
      description: "",
      size: :card,
      heading: :h1,
      id: "presskits-kit-cover",
      show_image: !embargoed?,
      context: :header
    ) do |cover| %>
      <% cover.with_after_location do %>
        <%= helpers.render_embargo_notice(@press_kit_recording, size: :md, id: "presskits-preview-embargo") %>
      <% end %>
    <% end %>
  <% end %>

  <% if show_preview_details? %>
  <%= render RecordingStudioPresskits::PressKits::SectionCardComponent.new do %>
    <div id="presskits-preview-details" class="<%= RecordingStudioPresskits::PressKits::EditorChrome::SECTION_PAD_CLASSES %> flex flex-col gap-6">
      <% if show_access_heading? %>
        <%= render heading_component %>
        <p data-presskits-preview-explanation><%= explanation %></p>
      <% end %>

      <% if show_auth_actions? %>
        <div class="flex flex-wrap items-center gap-3">
          <%= render FlatPack::Button::Component.new(
            text: sign_in_label,
            href: sign_in_path,
            style: :primary
          ) %>
          <% if registration_path.present? %>
            <%= render FlatPack::Button::Component.new(
              text: register_label,
              href: registration_path,
              style: :secondary
            ) %>
          <% end %>
        </div>
      <% end %>
    </div>
  <% end %>
  <% end %>
</div>
