<div id="presskits-public-preview" class="<%= RecordingStudioPresskits::PressKits::EditorChrome::PREVIEW_CLASSES %>" data-presskits-presentation="preview">
  <%= render FlatPack::Card::Component.new(
    style: :default,
    class: RecordingStudioPresskits::PressKits::EditorChrome::KIT_CARD_CLASSES,
    padding: :none
  ) do %>
    <%= render RecordingStudioPresskits::Cover::Component.new(
      recording: @press_kit_recording,
      size: :hero,
      show_image: !embargoed?
    ) %>
  <% end %>

  <%= render RecordingStudioPresskits::PressKits::SectionCardComponent.new do %>
    <div id="presskits-preview-details" class="<%= RecordingStudioPresskits::PressKits::EditorChrome::SECTION_PAD_CLASSES %> flex flex-col gap-6">
      <% if embargoed? %>
        <div id="presskits-embargo-marker" class="flex flex-col gap-3" data-presskits-embargo="true">
          <%= render FlatPack::Badge::Component.new(text: embargo_badge, style: :warning, size: :sm) %>
          <% if embargo_until.present? %>
            <p data-presskits-embargo-until><%= embargo_until %></p>
          <% end %>
        </div>
      <% end %>

      <% if show_access_heading? %>
        <%= render heading_component %>
        <p data-presskits-preview-explanation><%= explanation %></p>
      <% end %>

      <% if show_auth_actions? %>
        <div class="flex flex-wrap items-center gap-3">
          <%= render FlatPack::Button::Component.new(
            text: sign_in_label,
            href: sign_in_path,
            style: :primary
          ) %>
          <% if registration_path.present? %>
            <%= render FlatPack::Button::Component.new(
              text: register_label,
              href: registration_path,
              style: :secondary
            ) %>
          <% end %>
        </div>
      <% end %>
    </div>
  <% end %>
</div>
