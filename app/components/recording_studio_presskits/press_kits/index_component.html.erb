<div class="flex w-full flex-col gap-6 p-6">
  <%= render FlatPack::PageTitle::Component.new(
    title: I18n.t("recording_studio_presskits.index.title"),
    subtitle: I18n.t("recording_studio_presskits.index.subtitle"),
    variant: :h1
  ) %>

  <div class="flex flex-wrap items-center gap-3">
    <%= render FlatPack::Button::Component.new(
      text: I18n.t("recording_studio_presskits.index.new"),
      icon: "plus",
      style: :primary,
      href: @new_path
    ) %>

    <%= render FlatPack::SegmentedButtons::Component.new(style: :default) do |group| %>
      <% group.button(text: I18n.t("recording_studio_presskits.index.status.all"), href: filter_path(status: "all"), selected: status_selected?("all")) %>
      <% group.button(text: I18n.t("recording_studio_presskits.index.status.draft"), href: filter_path(status: "draft"), selected: status_selected?("draft")) %>
      <% group.button(text: I18n.t("recording_studio_presskits.index.status.published"), href: filter_path(status: "published"), selected: status_selected?("published")) %>
    <% end %>

    <%= form_with url: search_path, method: :get, local: true, data: { turbo: false } do %>
      <%= render FlatPack::Search::Component.new(
        name: "q",
        value: @query.presence,
        placeholder: I18n.t("recording_studio_presskits.index.search_placeholder"),
        max_width: :md
      ) %>
    <% end %>
  </div>

  <% if @press_kit_recordings.empty? %>
    <%= render FlatPack::EmptyState::Component.new(
      title: I18n.t(filtered? ? "recording_studio_presskits.index.no_matches_title" : "recording_studio_presskits.index.empty_title"),
      description: I18n.t(filtered? ? "recording_studio_presskits.index.no_matches_description" : "recording_studio_presskits.index.empty_description"),
      icon: :inbox
    ) %>
  <% else %>
    <%= render FlatPack::Grid::Component.new(cols: 3, gap: :lg, align: :stretch) do %>
      <% @press_kit_recordings.each do |recording| %>
        <%= render RecordingStudioPresskits::Cover::Component.new(
          recording: recording,
          size: :card,
          context: :grid
        ) do |cover| %>
          <%= render RecordingStudioPresskits::Cover::DefaultActionsComponent.new(
            cover: cover,
            recording: recording,
            context: :grid,
            href: @show_path.call(recording)
          ) %>
        <% end %>
      <% end %>
    <% end %>
  <% end %>
</div>
