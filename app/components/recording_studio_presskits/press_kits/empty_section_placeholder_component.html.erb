<div id="presskits-section-placeholder" class="flex flex-col gap-4">
  <%= render FlatPack::EmptyState::Component.new(
    title: title,
    description: add_label,
    icon: :inbox
  ) %>
  <div class="<%= RecordingStudioPresskits::BrandStyle::NEUTRAL_CLASS %>" style="display: contents; <%= RecordingStudioPresskits::BrandStyle.neutral_style_attribute %>">
    <%= render FlatPack::Button::Component.new(
      text: add_label,
      style: :default,
      href: @edit_path,
      data: helpers.presskits_editor_open_data
    ) %>
  </div>
</div>
