<%# Heading left. Copy text sits in the reserved slot, top right. %>
<div id="<%= anchor_id %>" class="scroll-mt-24 flex w-full items-center justify-between gap-4">
  <div class="min-w-0">
    <h2 class="<%= title_classes %>"><%= title %></h2>
    <% if subtitle.present? %>
      <p class="<%= subtitle_classes %>"><%= subtitle %></p>
    <% end %>
  </div>
  <div class="shrink-0" data-presskits-text-copy-slot>
    <% if (button = copy_button) %>
      <%= render button %>
    <% end %>
  </div>
</div>
