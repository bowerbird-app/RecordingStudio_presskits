<% if @title.to_s.strip.present? %>
  <%= render FlatPack::SectionTitle::Component.new(
    title: @title,
    subtitle: @subtitle,
    anchor_link: @anchor_link,
    anchor_id: @anchor_id,
    size: @size,
    spacing: @spacing,
    level: @level
  ) do |section| %>
    <% if @trailing %>
      <% section.with_trailing do %>
        <%= render @trailing %>
      <% end %>
    <% end %>
  <% end %>
<% elsif @subtitle.to_s.strip.present? %>
  <%= render FlatPack::SectionTitle::Component.new(
    title: @subtitle,
    anchor_link: @anchor_link,
    anchor_id: @anchor_id,
    size: :md,
    spacing: @spacing,
    level: @level
  ) %>
<% end %>
