<%= turbo_frame_tag section_id do %>
  <section
    id="<%= section_id %>-body"
    class="group/section relative rounded-[var(--radius-lg)] p-4 -mx-4 outline outline-2 outline-transparent transition-[outline-color] duration-[var(--duration-base)] hover:outline-[var(--color-primary)] focus-within:outline-[var(--color-primary)] <%= "ring-2 ring-[var(--color-primary)]" if highlight? %>"
    data-controller="recording-studio-presskits--section-highlight"
    data-recording-studio-presskits--section-highlight-enabled-value="<%= highlight? %>"
    tabindex="0"
  >
    <div class="flex flex-wrap items-start justify-between gap-3">
      <div class="min-w-0 flex-1">
        <%= render frame.heading_component %>
      </div>
      <div class="opacity-0 transition-opacity duration-[var(--duration-base)] group-hover/section:opacity-100 group-focus-within/section:opacity-100 focus-within:opacity-100">
        <%= render FlatPack::Button::Component.new(
          text: edit_heading_label,
          style: :ghost,
          size: :sm,
          href: @heading_path,
          data: helpers.presskits_editor_open_data
        ) %>
      </div>
    </div>

    <div class="relative mt-4">
      <% if content_visible? %>
        <%= render frame.content_view %>
      <% else %>
        <%= render RecordingStudioPresskits::PressKits::EmptySectionPlaceholderComponent.new(
          content_type: content_type,
          edit_path: @content_path
        ) %>
      <% end %>

      <div class="mt-3 opacity-0 transition-opacity duration-[var(--duration-base)] group-hover/section:opacity-100 group-focus-within/section:opacity-100 focus-within:opacity-100">
        <%= render FlatPack::Button::Component.new(
          text: edit_content_label,
          style: :ghost,
          size: :sm,
          href: @content_path,
          data: helpers.presskits_editor_open_data
        ) %>
      </div>
    </div>

    <div class="mt-4 flex justify-center opacity-0 transition-opacity duration-[var(--duration-base)] group-hover/section:opacity-100 group-focus-within/section:opacity-100 focus-within:opacity-100">
      <%= render RecordingStudioPresskits::PressKits::SectionDropdownComponent.new(
        items: @picker_items,
        add_path: @add_path,
        after_recording_id: @section_recording.id,
        compact: true
      ) %>
    </div>
  </section>
<% end %>
