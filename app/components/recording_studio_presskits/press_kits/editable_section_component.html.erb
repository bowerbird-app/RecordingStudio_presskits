<%= helpers.turbo_frame_tag section_id do %>
  <section
    id="<%= section_id %>-body"
    class="<%= chrome_class %>"
    data-controller="recording-studio-presskits--section-highlight"
    data-recording-studio-presskits--section-highlight-enabled-value="<%= highlight? %>"
    tabindex="0"
  >
    <div class="flex flex-wrap items-start justify-between gap-3">
      <div class="min-w-0 flex-1">
        <%= render frame.heading_component %>
      </div>
      <div class="<%= controls_class %>">
        <%= render FlatPack::Button::Component.new(
          text: edit_heading_label,
          style: :ghost,
          size: :sm,
          href: @heading_path,
          data: helpers.presskits_editor_open_data
        ) %>
      </div>
    </div>

    <div class="relative mt-4">
      <% if content_visible? %>
        <%= render frame.content_view %>
      <% else %>
        <%= render RecordingStudioPresskits::PressKits::EmptySectionPlaceholderComponent.new(
          content_type: content_type,
          edit_path: @content_path
        ) %>
      <% end %>

      <div class="mt-3 <%= controls_class %>">
        <%= render FlatPack::Button::Component.new(
          text: edit_content_label,
          style: :ghost,
          size: :sm,
          href: @content_path,
          data: helpers.presskits_editor_open_data
        ) %>
      </div>
    </div>

    <div class="mt-4 flex justify-center <%= controls_class %>">
      <%= render RecordingStudioPresskits::PressKits::SectionDropdownComponent.new(
        items: @picker_items,
        add_path: @add_path,
        after_recording_id: @section_recording.id,
        compact: true
      ) %>
    </div>
  </section>
<% end %>
