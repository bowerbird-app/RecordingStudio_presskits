<%= helpers.turbo_frame_tag section_id do %>
  <%= render RecordingStudioPresskits::PressKits::SectionCardComponent.new do %>
  <section
    id="<%= section_id %>-body"
    class="<%= region_classes %>"
    data-controller="recording-studio-presskits--section-highlight"
    data-recording-studio-presskits--section-highlight-enabled-value="<%= highlight? %>"
    data-presskits-editor-region="section"
    tabindex="0"
  >
    <div class="flex flex-col-reverse gap-4 sm:flex-row sm:items-start sm:justify-between">
      <div class="min-w-0 flex-1">
        <%= render inline_heading %>
      </div>

      <div
        id="<%= actions_id %>"
        class="<%= action_row_classes %> <%= RecordingStudioPresskits::BrandStyle::NEUTRAL_CLASS %>"
        style="<%= RecordingStudioPresskits::BrandStyle.neutral_style_attribute %>"
        data-presskits-section-actions
      >
        <% if show_content_edit? %>
          <%= render FlatPack::Button::Component.new(
            text: edit_label,
            icon: "pencil",
            style: :default,
            size: :sm,
            href: @content_path,
            class: mobile_icon_classes,
            aria: { label: edit_label },
            data: helpers.presskits_editor_open_data
          ) %>
        <% end %>
        <%= render FlatPack::Button::Component.new(
          text: order_label,
          icon: "bars-3-bottom-left",
          style: :default,
          size: :sm,
          href: reorder_focus_href,
          class: mobile_icon_classes,
          aria: { label: order_label },
          data: { modal_id: "presskits-sections-modal" }
        ) %>
        <%= render FlatPack::TrashButton::Component.new(
          url: @remove_path,
          method: :delete,
          size: :sm,
          expand: :left,
          style: trash_size_style
        ) %>
      </div>
    </div>

    <% if text_section? %>
      <%= render text_inline %>
    <% elsif content_visible? %>
      <%= render frame.content_view %>
    <% else %>
      <%= render RecordingStudioPresskits::PressKits::EmptySectionPlaceholderComponent.new(
        content_type: frame.content_recording&.recordable_type,
        edit_path: @content_path
      ) %>
    <% end %>
  </section>
  <% end %>
<% end %>
