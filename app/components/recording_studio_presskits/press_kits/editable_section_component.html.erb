<%= helpers.turbo_frame_tag section_id do %>
  <section
    id="<%= section_id %>-body"
    class="<%= region_classes %>"
    data-controller="recording-studio-presskits--section-highlight"
    data-recording-studio-presskits--section-highlight-enabled-value="<%= highlight? %>"
    data-presskits-editor-region="section"
    tabindex="0"
  >
    <%= render frame.heading_component %>

    <% if content_visible? %>
      <%= render frame.content_view %>
    <% else %>
      <%= render RecordingStudioPresskits::PressKits::EmptySectionPlaceholderComponent.new(
        content_type: content_type,
        edit_path: @content_path
      ) %>
    <% end %>

    <%= render FlatPack::Fab::Component.new(
      contained: true,
      position: :top_right,
      backdrop: false,
      icon: :ellipsis_vertical,
      label: section_actions_label,
      class: fab_classes
    ) do |fab| %>
      <% fab.with_action(
        icon: :pencil,
        label: edit_title_label,
        href: @heading_path,
        data: helpers.presskits_editor_open_data
      ) %>
      <% fab.with_action(
        icon: :document_text,
        label: edit_content_label,
        href: @content_path,
        data: helpers.presskits_editor_open_data
      ) %>
      <% fab.with_action(
        icon: :bars_3_bottom_left,
        label: reorder_label,
        href: reorder_focus_href,
        data: { modal_id: "presskits-sections-modal" }
      ) %>
      <% fab.with_action(
        icon: :trash,
        label: trash_label,
        href: @remove_path,
        data: {
          turbo_method: :delete,
          turbo_stream: true,
          turbo_confirm: trash_confirm
        }
      ) %>
      <% fab.with_action(
        icon: :plus,
        label: add_new_section_label,
        data: { modal_id: picker_modal_id }
      ) %>
    <% end %>
  </section>

  <%= render FlatPack::Modal::Component.new(
    id: picker_modal_id,
    title: I18n.t("recording_studio_presskits.editor.picker_title"),
    size: :md,
    scroll: :page
  ) do |modal| %>
    <% modal.body do %>
      <%= render RecordingStudioPresskits::PressKits::SectionPickerComponent.new(
        items: @picker_items,
        add_path: @add_path,
        after_recording_id: @section_recording.id
      ) %>
    <% end %>
  <% end %>
<% end %>
