<div
  id="presskits-kit-header"
  class="<%= region_classes %>"
  data-presskits-editor-region="header"
  tabindex="0"
>
  <%= render RecordingStudioPresskits::Cover::Component.new(
    recording: @press_kit_recording,
    size: :card,
    heading: :h1,
    id: "presskits-kit-cover",
    inline_path: helpers.press_kit_header_path(@press_kit_recording)
  ) %>

  <%= render FlatPack::Fab::Component.new(
    contained: true,
    position: :top_right,
    backdrop: false,
    size: :sm,
    icon: :plus,
    offset: fab_offset,
    label: header_actions_label,
    class: fab_classes
  ) do |fab| %>
    <% fab.with_action(
      icon: "map-pin",
      label: location_label,
      href: @header_edit_path,
      data: helpers.presskits_editor_open_data
    ) %>
    <% fab.with_action(
      icon: :swatch,
      label: style_label,
      href: "#{@header_edit_path}#presskits-header-brand",
      data: helpers.presskits_editor_open_data
    ) %>
    <% if cover_image_path %>
      <% fab.with_action(
        icon: :photo,
        label: cover_image_label,
        href: cover_image_path,
        data: helpers.presskits_editor_open_data
      ) %>
    <% end %>
  <% end %>
</div>
