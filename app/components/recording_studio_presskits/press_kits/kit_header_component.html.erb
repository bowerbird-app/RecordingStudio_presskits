<div
  id="presskits-kit-header"
  class="<%= region_classes %>"
  data-presskits-editor-region="header"
  tabindex="0"
>
  <%= render RecordingStudioPresskits::Cover::Component.new(
    recording: @press_kit_recording,
    size: :card,
    heading: :h1,
    id: "presskits-kit-cover",
    inline_path: helpers.press_kit_header_path(@press_kit_recording)
  ) do |cover| %>
    <% cover.with_body_actions do %>
      <div
        class="<%= action_row_classes %> <%= RecordingStudioPresskits::BrandStyle::NEUTRAL_CLASS %>"
        style="<%= RecordingStudioPresskits::BrandStyle.neutral_style_attribute %>"
        data-presskits-header-actions
      >
        <%= render RecordingStudioPresskits::PressKits::EditorActionButtonComponent.new(
          text: edit_label,
          icon: "pencil",
          href: @header_edit_path,
          data: helpers.presskits_editor_open_data
        ) %>
      </div>
    <% end %>
    <% if cover_image_path %>
      <% cover.with_image_actions do %>
        <div
          class="<%= image_action_classes %> <%= RecordingStudioPresskits::BrandStyle::NEUTRAL_CLASS %>"
          style="<%= RecordingStudioPresskits::BrandStyle.neutral_style_attribute %>"
          data-presskits-header-image-actions
        >
          <%= render RecordingStudioPresskits::PressKits::EditorActionButtonComponent.new(
            text: edit_image_label,
            icon: "photo",
            href: cover_image_path,
            data: helpers.presskits_editor_open_data
          ) %>
        </div>
      <% end %>
    <% end %>
  <% end %>
</div>
