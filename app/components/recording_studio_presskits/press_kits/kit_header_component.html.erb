<div
  id="presskits-kit-header"
  class="group/header relative rounded-[var(--radius-lg)] p-4 -mx-4 outline outline-2 outline-transparent transition-[outline-color] duration-[var(--duration-base)] hover:outline-[var(--color-primary)] focus-within:outline-[var(--color-primary)]"
  tabindex="0"
>
  <%= render FlatPack::PageTitle::Component.new(**page_title_options) %>
  <div class="mt-3 opacity-0 transition-opacity duration-[var(--duration-base)] group-hover/header:opacity-100 group-focus-within/header:opacity-100 focus-within:opacity-100">
    <%= render FlatPack::Button::Component.new(
      text: edit_heading_label,
      style: :ghost,
      size: :sm,
      href: @header_edit_path,
      data: helpers.presskits_editor_open_data
    ) %>
  </div>
</div>
