<%= render FlatPack::Button::Dropdown::Component.new(
  text: "Add a section",
  style: :secondary,
  placement: :bottom_left,
  id: "presskits-section-dropdown"
) do |dropdown| %>
  <% @items.each do |item| %>
    <% dropdown.menu_item(
      text: item[:label],
      href: add_path_for(item[:id]),
      data: { turbo_method: :post }
    ) %>
  <% end %>
<% end %>
