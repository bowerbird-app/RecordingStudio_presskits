<div
  class="flex flex-col gap-6"
  data-controller="recording-studio-presskits--editor-chrome"
  data-action="pointerdown@window->recording-studio-presskits--editor-chrome#onPointerDown keydown@window->recording-studio-presskits--editor-chrome#prepareEditorFrame"
>
  <div id="presskits-editor-toolbar" class="flex flex-wrap items-center gap-3">
    <%= render FlatPack::Button::Component.new(
      text: I18n.t("recording_studio_presskits.editor.add_section"),
      icon: "plus",
      style: :primary,
      id: "presskits-section-picker",
      disabled: picker_items.empty?,
      data: { modal_id: "presskits-section-picker-modal" }
    ) %>

    <%= render FlatPack::Button::Component.new(
      text: I18n.t("recording_studio_presskits.editor.order"),
      icon: "bars-3-bottom-left",
      style: :default,
      data: { modal_id: "presskits-sections-modal" }
    ) %>

    <% if visibility_edit_path.present? %>
      <%= render FlatPack::Button::Component.new(
        text: I18n.t("recording_studio_presskits.editor.visibility"),
        icon: "eye",
        style: :default,
        href: visibility_edit_path,
        id: "presskits-visibility",
        data: helpers.presskits_editor_open_data(size: :md)
      ) %>
    <% end %>

    <% if @download_edit_path.present? %>
      <%= render FlatPack::Button::Component.new(
        text: I18n.t("recording_studio_presskits.editor.downloads"),
        icon: "arrow-down-tray",
        style: :default,
        href: @download_edit_path,
        id: "presskits-downloads",
        data: helpers.presskits_editor_open_data(size: :md)
      ) %>
    <% end %>

    <% if helpers.respond_to?(:render_embargo_button) %>
      <%= helpers.render_embargo_button(@press_kit_recording) %>
    <% end %>

    <%= helpers.render_publishable_quick_actions(@press_kit_recording) %>
  </div>

  <div
    id="presskits-editor-preview"
    class="<%= RecordingStudioPresskits::PressKits::EditorChrome::PREVIEW_CLASSES %>"
    data-presskits-brand="true"
    style="<%= preview_brand_style %>"
  >
    <%= render RecordingStudioPresskits::PressKits::KitHeaderComponent.new(
      press_kit_recording: @press_kit_recording,
      header_edit_path: @header_edit_path
    ) %>

    <%= helpers.turbo_frame_tag "presskits-editor-sections", class: RecordingStudioPresskits::PressKits::EditorChrome::KIT_SECTIONS_CLASSES do %>
      <% if @section_recordings.any? %>
        <% @section_recordings.each do |recording| %>
          <%= render RecordingStudioPresskits::PressKits::EditableSectionComponent.new(
            section_recording: recording,
            content_path: @edit_path.call(recording),
            remove_path: @remove_path.call(recording),
            highlight: highlight?(recording)
          ) %>
        <% end %>
      <% else %>
        <%= render RecordingStudioPresskits::PressKits::SectionCardComponent.new do %>
          <div class="<%= RecordingStudioPresskits::PressKits::EditorChrome::SECTION_PAD_CLASSES %>">
            <%= render FlatPack::EmptyState::Component.new(
              title: I18n.t("recording_studio_presskits.editor.empty_kit"),
              description: I18n.t("recording_studio_presskits.editor.empty_kit_hint"),
              icon: :inbox
            ) %>
          </div>
        <% end %>
      <% end %>
    <% end %>
  </div>

  <div id="presskits-toasts" class="pointer-events-none fixed right-4 bottom-4 z-[60] flex flex-col gap-3"></div>
  <%= render RecordingStudioPresskits::ToastsRegionComponent.new %>

  <% [["md", :md], ["lg", :lg], ["xl", :xl], ["2xl", :"2xl"]].each do |size_name, size| %>
    <%= render FlatPack::Modal::Component.new(
      id: helpers.presskits_editor_modal_id_for(size_name),
      navigable: true,
      src: @header_edit_path,
      size: size,
      scroll: :page
    ) %>
  <% end %>

  <%= render FlatPack::Modal::Component.new(
    id: "presskits-section-picker-modal",
    title: I18n.t("recording_studio_presskits.editor.picker_title"),
    size: :md,
    scroll: :page
  ) do |modal| %>
    <% modal.body do %>
      <%= render RecordingStudioPresskits::PressKits::SectionPickerComponent.new(
        items: picker_items,
        add_path: @add_path
      ) %>
    <% end %>
  <% end %>

  <%= render FlatPack::Modal::Component.new(
    id: "presskits-sections-modal",
    title: I18n.t("recording_studio_presskits.editor.reorder"),
    size: :md,
    scroll: :page
  ) do |modal| %>
    <% modal.body do %>
      <%= render RecordingStudioPresskits::PressKits::SectionsOrderComponent.new(
        section_recordings: @section_recordings,
        remove_path: @remove_path,
        edit_path: @edit_path,
        reorder_path: @reorder_path
      ) %>
    <% end %>
  <% end %>
</div>
