<%= render FlatPack::Grid::Component.new(cols: 2, gap: :lg, align: :start) do %>
  <div class="flex min-w-0 flex-col items-start gap-6">
    <% editor = RecordingStudioPresskits.section_editor_for(@recording) %>
    <% if editor %>
      <%= render editor.new(recording: @recording, update_path: @update_path) %>
    <% else %>
      <p class="text-sm font-medium text-(--surface-content-color)">
        <%= @recording.type_label %>
      </p>
    <% end %>

    <%= form_with url: @remove_path, method: :delete, local: true do %>
      <%= render FlatPack::Button::Component.new(text: "Remove", style: :ghost, type: "submit") %>
    <% end %>
  </div>

  <div class="min-w-0">
    <% component = RecordingStudioPresskits.section_component_for(@recording) %>
    <% if component %>
      <%= render component.new(recording: @recording) %>
    <% else %>
      <p class="text-sm font-medium text-(--surface-content-color)">
        <%= helpers.presskits_title_for(@recording) %>
      </p>
    <% end %>
  </div>
<% end %>
