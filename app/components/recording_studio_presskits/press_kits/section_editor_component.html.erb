<div class="flex flex-col gap-6">
  <%= render FlatPack::PageTitle::Component.new(
    title: @recording.type_label,
    variant: :h1
  ) %>

  <% editor = editor_class %>
  <% upload_data = nil %>
  <% if form? && editor_view&.respond_to?(:upload_form_data) %>
    <% upload_data = editor_view.upload_form_data(helpers) %>
  <% end %>
  <% grid = capture do %>
    <%= render FlatPack::Grid::Component.new(cols: grid_cols, gap: :lg, align: :start) do %>
      <div class="flex w-full min-w-0 flex-col gap-6">
        <% if editor %>
          <%= render editor_view %>
        <% else %>
          <p class="text-sm font-medium text-(--surface-content-color)">
            <%= @recording.type_label %>
          </p>
        <% end %>
      </div>

      <% if show_preview? %>
        <div class="min-w-0" id="presskits-section-preview">
          <% section_preview = capture do %>
            <% component = RecordingStudioPresskits.section_component_for(@recording) %>
            <% if component %>
              <%= render component.new(recording: @recording) %>
            <% else %>
              <p class="text-sm font-medium text-(--surface-content-color)">
                <%= helpers.presskits_title_for(@recording) %>
              </p>
            <% end %>
          <% end %>
          <%= render FlatPack::Card::Component.new(style: :default, class: "w-full") do |card| %>
            <% if preview_card_title.present? %>
              <% card.header do %>
                <%= render FlatPack::PageTitle::Component.new(
                  title: preview_card_title,
                  variant: :h2
                ) %>
              <% end %>
              <% card.body do %>
                <%= section_preview %>
              <% end %>
            <% else %>
              <%= section_preview %>
            <% end %>
          <% end %>
        </div>
      <% end %>
    <% end %>
  <% end %>

  <% if editor && form? %>
    <%= form_with url: @update_path, method: :patch, local: true,
          class: "flex flex-col gap-6", **(upload_data ? { data: upload_data } : {}) do %>
      <div id="presskits-section-actions" class="flex flex-wrap items-center gap-3">
        <%= render FlatPack::Button::Component.new(text: "Update", style: :primary, type: "submit") %>
        <%= render FlatPack::Button::Component.new(text: "Cancel", style: :default, href: cancel_path) %>
        <% if upload_data %>
          <%= render FlatPack::Button::Component.new(
            text: "Upload",
            icon: "upload",
            style: :default,
            type: "button",
            data: { action: "recording-studio-attachable--upload#browse" }
          ) %>
        <% end %>
      </div>

      <%= grid %>
    <% end %>
  <% else %>
    <% if editor_view&.respond_to?(:section_actions) %>
      <div id="presskits-section-actions" class="flex flex-wrap items-center gap-3">
        <%= render editor_view.section_actions %>
      </div>
    <% end %>
    <%= grid %>
  <% end %>

  <% if editor_view&.respond_to?(:attachment_collection_options) %>
    <%= helpers.attachment_collection_editor(
          @recording,
          **editor_view.attachment_collection_options,
          return_to: helpers.edit_press_kit_section_path(@recording.parent_recording, @recording)
        ) %>
  <% end %>
</div>
