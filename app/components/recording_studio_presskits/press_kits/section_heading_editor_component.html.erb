<%= form_with url: @update_path, method: :patch,
      id: "presskits-section-title-form",
      class: "flex flex-col gap-6",
      data: helpers.presskits_editor_save_data.merge(controller: "flat-pack--unsaved-changes") do %>
  <%= hidden_field_tag :from_kit_editor, "1" if helpers.presskits_editor_dialog? %>
  <%= render FlatPack::TextInput::Component.new(
    name: "kit_section[title]",
    value: section_title,
    label: "Title",
    placeholder: section_title_fallback,
    class: "w-full"
  ) %>
  <%= render FlatPack::TextInput::Component.new(
    name: "kit_section[subtitle]",
    value: section_subtitle,
    label: "Subtitle",
    class: "w-full"
  ) %>
  <div id="presskits-section-update" class="flex flex-wrap items-center gap-3">
    <%= render update_button %>
  </div>
<% end %>
