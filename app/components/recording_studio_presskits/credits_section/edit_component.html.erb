<%= form_with model: batch, url: lines_path, method: :patch, local: true,
      html: { id: "presskits-credit-lines" }, class: "flex flex-col gap-6" do |form| %>
  <%= render FlatPack::Button::Component.new(text: "Save", style: :primary, type: "submit") %>

  <%= render FlatPack::CollectionEditor::Component.new(
    empty_text: "No credits yet",
    add_label: "Credit",
    headers: ["Credit", "Role on this kit"],
    orderable: true,
    orderable_url: order_path,
    param_uuid_name: "moving_recording_id",
    param_target_position_name: "target_position"
  ) do |editor| %>
    <% batch.credit_lines.each_with_index do |draft, index| %>
      <% form.fields_for :credit_lines, draft, child_index: index do |row_form| %>
        <% editor.with_row(form: row_form, record_id: draft.id) do |row| %>
          <%= render "recording_studio_presskits/credits_section/line_fields",
                row: row,
                row_form: row_form,
                title: draft.title,
                search_path: search_path,
                credits_path: credits_path %>
        <% end %>
      <% end %>
    <% end %>

    <% editor.with_template do %>
      <% form.fields_for :credit_lines, blank_line, child_index: "NEW_RECORD" do |row_form| %>
        <%= render FlatPack::CollectionEditor::Row::Component.new(form: row_form, index_token: "NEW_RECORD") do |row| %>
          <%= render "recording_studio_presskits/credits_section/line_fields",
                row: row,
                row_form: row_form,
                title: nil,
                search_path: search_path,
                credits_path: credits_path %>
        <% end %>
      <% end %>
    <% end %>
  <% end %>
<% end %>
