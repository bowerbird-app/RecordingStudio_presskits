<div
  class="flex max-w-xl flex-col gap-6"
  data-controller="recording-studio-presskits--add-credit"
  data-action="change->recording-studio-presskits--add-credit#choose"
  data-recording-studio-presskits--add-credit-credits-value="<%= credits_payload.to_json %>"
>
  <%= render FlatPack::PageTitle::Component.new(
    title: "Add credit",
    subtitle: subtitle,
    variant: :h1
  ) %>

  <% if credits.any? %>
    <div class="flex flex-col gap-4">
      <%= render FlatPack::PageTitle::Component.new(title: "Choose a credit", variant: :h2) %>

      <%= form_with url: @url, method: :post, local: true, class: "flex flex-col gap-4" do %>
        <%= render FlatPack::Select::Component.new(
          name: "credit_id",
          label: "Credit",
          options: credit_options,
          placeholder: "Search credits",
          searchable: true,
          class: "w-full"
        ) %>

        <div hidden data-recording-studio-presskits--add-credit-target="chosen" class="flex flex-col gap-4">
          <p
            class="text-sm font-medium text-(--surface-content-color)"
            data-recording-studio-presskits--add-credit-target="chosenName"
          ></p>
          <div data-recording-studio-presskits--add-credit-target="existingRole">
            <%= render FlatPack::TextInput::Component.new(
              name: "role",
              label: "Role on this kit",
              class: "w-full"
            ) %>
          </div>
        </div>

        <%= render FlatPack::Button::Component.new(text: "Add to this kit", style: :primary, type: "submit") %>
      <% end %>
    </div>
  <% end %>

  <div class="flex flex-col gap-4">
    <%= render FlatPack::PageTitle::Component.new(title: "Create a credit", variant: :h2) %>

    <%= form_with url: @url, method: :post, local: true, class: "flex flex-col gap-4" do %>
      <%= render FlatPack::TextInput::Component.new(
        name: "credit[name]",
        label: "Name",
        value: @credit.name,
        required: true,
        class: "w-full"
      ) %>
      <div
        data-recording-studio-presskits--add-credit-target="usualRole"
        data-action="input->recording-studio-presskits--add-credit#copyUsualRole"
      >
        <%= render FlatPack::TextInput::Component.new(
          name: "credit[usual_role]",
          label: "Usual role",
          value: @credit.usual_role,
          help_text: "Kits that already use this credit keep their own role.",
          class: "w-full"
        ) %>
      </div>
      <%= render FlatPack::TextInput::Component.new(
        name: "credit[url]",
        label: "URL",
        value: @credit.url,
        class: "w-full"
      ) %>
      <div
        data-recording-studio-presskits--add-credit-target="newRole"
        data-action="input->recording-studio-presskits--add-credit#touchKitRole"
      >
        <%= render FlatPack::TextInput::Component.new(
          name: "role",
          label: "Role on this kit",
          value: new_kit_role,
          class: "w-full"
        ) %>
      </div>

      <%= render FlatPack::Button::Component.new(text: "Create and add", style: create_button_style, type: "submit") %>
    <% end %>
  </div>
</div>
