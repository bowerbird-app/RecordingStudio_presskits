<%= render FlatPack::List::Component.new(divider: true, class: "w-full", data: { presskits_files: true }) do %>
  <% rows.each do |row| %>
    <%= render FlatPack::List::Item.new(icon: row[:icon], data: { presskits_file_id: row[:id] }) do %>
      <p class="text-base font-medium text-(--surface-content-color)" data-presskits-file-name><%= row[:name] %></p>
      <% if row[:description].present? %>
        <p class="mt-1 text-sm text-(--surface-muted-content-color)" data-presskits-file-description><%= row[:description] %></p>
      <% end %>
      <p class="mt-1 text-sm text-(--surface-muted-content-color)" data-presskits-file-meta><%= row[:meta] %></p>
    <% end %>
  <% end %>
<% end %>
