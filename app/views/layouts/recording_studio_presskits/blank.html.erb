<%# Public kit page: a document and the kit, with no page nav and no TopNav. %>
<% presentation = RecordingStudioPresskits::Visibility.apply_public_response!(
     presentation: @presskits_presentation,
     response: response
   ) %>
<% if %i[full preview].include?(presentation) %>
<!DOCTYPE html>
<html data-theme="rounded">
  <head>
    <title><%= content_for(:title).presence || "Press kit" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "flat_pack/variables", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "flat_pack/application", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "flat_pack/rich_text", "data-turbo-track": "reload" %>
    <%= yield :head %>
    <% if presentation == :preview %>
      <meta name="robots" content="noindex, nofollow">
      <% if content_for?(:seo_description) %>
        <meta name="description" content="<%= content_for(:seo_description) %>">
        <meta property="og:description" content="<%= content_for(:seo_description) %>">
      <% end %>
      <meta property="og:title" content="<%= content_for(:title).presence || "Press kit" %>">
      <meta property="og:type" content="website">
      <meta property="og:url" content="<%= request.original_url %>">
    <% elsif presentation == :full %>
      <% if respond_to?(:publishable_head_tags) %>
        <%= publishable_head_tags %>
      <% end %>
    <% end %>
    <%= javascript_importmap_tags if respond_to?(:javascript_importmap_tags) %>
  </head>

  <body class="bg-(--surface-page-background-color) text-(--surface-content-color)" data-theme="rounded" data-presskits-blank-layout="true">
    <main class="mx-auto min-h-screen w-full max-w-6xl p-6">
      <%= yield %>
    </main>
  </body>
</html>
<% end %>
