<% credit_title = @credit_recording&.recordable&.title || "Credit" %>
<% if presskits_editor_dialog? %>
  <%= flat_pack_modal_screen(modal_id: presskits_editor_modal_id, title: credit_title) do %>
    <%= render RecordingStudioPresskits::CreditLine::EditComponent.new(
      line_recording: @line_recording,
      section_recording: @section_recording,
      credit_recording: @credit_recording
    ) %>
  <% end %>
<% else %>
  <% presskits_page_nav(
    title: credit_title,
    back_url: edit_press_kit_section_path(@press_kit_recording, @section_recording),
    back_label: "Back to credits",
    close_url: edit_press_kit_path(@press_kit_recording)
  ) %>

  <%= render RecordingStudioPresskits::CreditLine::EditComponent.new(
    line_recording: @line_recording,
    section_recording: @section_recording,
    credit_recording: @credit_recording
  ) %>
<% end %>
