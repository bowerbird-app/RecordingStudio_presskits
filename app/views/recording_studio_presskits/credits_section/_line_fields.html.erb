<% row.with_field do %>
  <%= render FlatPack::TextInput::Component.new(
    name: row_form.field_name(:name),
    id: row_form.field_id(:name),
    label: "Name",
    value: row_form.object.name,
    required: true,
    chrome: :cell
  ) %>
<% end %>
<% row.with_field do %>
  <%= render FlatPack::TextInput::Component.new(
    name: row_form.field_name(:role),
    id: row_form.field_id(:role),
    label: "Role",
    value: row_form.object.role,
    chrome: :cell
  ) %>
<% end %>
<% row.with_field do %>
  <%= render FlatPack::TextInput::Component.new(
    name: row_form.field_name(:url),
    id: row_form.field_id(:url),
    label: "URL",
    value: row_form.object.url,
    chrome: :cell
  ) %>
<% end %>
