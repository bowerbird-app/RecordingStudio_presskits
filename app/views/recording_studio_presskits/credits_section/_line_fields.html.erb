<% row.with_entity(
  form: row_form,
  association_name: :credit_recording_id,
  title: title,
  label: "Credit",
  search_url: search_path,
  create_url: credits_path,
  create_label: "Create",
  search_placeholder: "Search credits",
  empty_text: "No matches"
) do %>
  <%= render FlatPack::TextInput::Component.new(
    name: "name",
    label: "Name",
    required: true,
    form: "collection-editor-unattached",
    data: { create_field: "name", fill_from_query: "true" }
  ) %>
  <%= render FlatPack::TextInput::Component.new(
    name: "usual_role",
    label: "Default role",
    help_text: "Kits that already use this credit keep their own role.",
    form: "collection-editor-unattached",
    data: { create_field: "usual_role" }
  ) %>
  <%= render FlatPack::TextInput::Component.new(
    name: "url",
    label: "URL",
    form: "collection-editor-unattached",
    data: { create_field: "url" }
  ) %>
<% end %>
<% row.with_field do %>
  <%= render FlatPack::TextInput::Component.new(
    name: row_form.field_name(:role),
    id: row_form.field_id(:role),
    label: "Role on this kit",
    value: row_form.object.role,
    chrome: :cell
  ) %>
<% end %>
