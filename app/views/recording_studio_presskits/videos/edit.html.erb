<% video = @video || @video_recording.recordable %>
<% video_title = video.title.presence || "Video" %>
<% if presskits_editor_dialog? %>
  <%= flat_pack_modal_screen(modal_id: presskits_editor_modal_id, title: video_title) do %>
    <%= render RecordingStudioPresskits::Videos::EditComponent.new(
      video: video,
      section_recording: @section_recording,
      video_recording: @video_recording
    ) %>
  <% end %>
<% else %>
  <% presskits_page_nav(
    title: video_title,
    back_url: edit_press_kit_section_path(@press_kit_recording, @section_recording),
    back_label: "Back to video",
    close_url: edit_press_kit_path(@press_kit_recording)
  ) %>

  <%= render RecordingStudioPresskits::Videos::EditComponent.new(
    video: video,
    section_recording: @section_recording,
    video_recording: @video_recording
  ) %>
<% end %>
