<% fact = @fact || @fact_recording.recordable %>
<% fact_title = fact.label.to_s.strip.presence || "Fact" %>
<% if presskits_editor_dialog? %>
  <%= flat_pack_modal_screen(modal_id: presskits_editor_modal_id, title: fact_title) do %>
    <%= render RecordingStudioPresskits::Fact::EditComponent.new(
      fact: fact,
      section_recording: @section_recording,
      fact_recording: @fact_recording
    ) %>
  <% end %>
<% else %>
  <% presskits_page_nav(
    title: fact_title,
    back_url: edit_press_kit_section_path(@press_kit_recording, @section_recording),
    back_label: "Back to facts",
    close_url: edit_press_kit_path(@press_kit_recording)
  ) %>

  <%= render RecordingStudioPresskits::Fact::EditComponent.new(
    fact: fact,
    section_recording: @section_recording,
    fact_recording: @fact_recording
  ) %>
<% end %>
