<%= render FlatPack::List::Component.new(divider: true) do %>
  <% column.each do |recording| %>
    <% item = recording.recordable %>
    <%= render FlatPack::List::Item.new(
          icon: item.icon.presence,
          class: "!items-center",
          data: { list_item: true }
        ) do %>
      <span class="text-(--surface-muted-content-color)"><%= item.key %>:</span>
      <span><%= item.value %></span>
    <% end %>
  <% end %>
<% end %>
