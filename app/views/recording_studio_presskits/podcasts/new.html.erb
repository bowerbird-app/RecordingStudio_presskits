<% podcast_title = @podcast.episode_title %>
<% if presskits_editor_dialog? %>
  <%= flat_pack_modal_screen(modal_id: presskits_editor_modal_id, title: podcast_title) do %>
    <%= render RecordingStudioPresskits::Podcasts::EditComponent.new(
      podcast: @podcast,
      section_recording: @section_recording
    ) %>
  <% end %>
<% else %>
  <% presskits_page_nav(
    title: podcast_title,
    back_url: edit_press_kit_section_path(@press_kit_recording, @section_recording),
    back_label: "Back to podcasts",
    close_url: edit_press_kit_path(@press_kit_recording)
  ) %>

  <%= render RecordingStudioPresskits::Podcasts::EditComponent.new(
    podcast: @podcast,
    section_recording: @section_recording
  ) %>
<% end %>
