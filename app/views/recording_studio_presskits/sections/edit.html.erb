<% content_title = (@section_recording && RecordingStudioPresskits::KitQuery.section_content(@section_recording)&.type_label) || I18n.t("recording_studio_presskits.editor.content_title") %>
<% if presskits_editor_dialog? %>
  <%= flat_pack_modal_screen(modal_id: presskits_editor_modal_id, title: content_title) do %>
    <%= render RecordingStudioPresskits::PressKits::SectionEditorComponent.new(
      recording: @section_recording,
      update_path: press_kit_section_path(@press_kit_recording, @section_recording)
    ) %>
  <% end %>
<% else %>
  <% presskits_page_nav(
    title: presskits_title_for(@section_recording),
    back_url: edit_press_kit_path(@press_kit_recording),
    back_label: "Back to kit",
    close_url: edit_press_kit_path(@press_kit_recording)
  ) %>

  <%= render FlatPack::PageTitle::Component.new(
    title: content_title,
    variant: :h1
  ) %>

  <%= render RecordingStudioPresskits::PressKits::SectionEditorComponent.new(
    recording: @section_recording,
    update_path: press_kit_section_path(@press_kit_recording, @section_recording)
  ) %>
<% end %>
