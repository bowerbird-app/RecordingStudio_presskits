<% if presskits_editor_dialog? %>
  <%= flat_pack_modal_screen(modal_id: presskits_editor_modal_id, title: I18n.t("recording_studio_presskits.visibility.title")) do %>
    <%= render RecordingStudioPresskits::PressKits::VisibilityEditorComponent.new(
      press_kit_recording: @press_kit_recording,
      audience: @visibility_audience,
      options: @visibility_options,
      fallback: @visibility_fallback,
      constrained: @visibility_constrained
    ) %>
  <% end %>
<% else %>
  <% presskits_page_nav(
    title: I18n.t("recording_studio_presskits.visibility.title"),
    back_url: edit_press_kit_path(@press_kit_recording),
    back_label: I18n.t("recording_studio_presskits.visibility.back"),
    close_url: edit_press_kit_path(@press_kit_recording)
  ) %>

  <%= render FlatPack::PageTitle::Component.new(
    title: I18n.t("recording_studio_presskits.visibility.title"),
    subtitle: I18n.t("recording_studio_presskits.visibility.subtitle"),
    variant: :h1
  ) %>

  <%= render RecordingStudioPresskits::PressKits::VisibilityEditorComponent.new(
    press_kit_recording: @press_kit_recording,
    audience: @visibility_audience,
    options: @visibility_options,
    fallback: @visibility_fallback,
    constrained: @visibility_constrained
  ) %>
<% end %>
