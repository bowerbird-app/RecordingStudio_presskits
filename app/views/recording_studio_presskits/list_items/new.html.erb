<% if presskits_editor_dialog? %>
  <%= flat_pack_modal_screen(modal_id: presskits_editor_modal_id, title: "Item") do %>
    <%= render RecordingStudioPresskits::ListItem::EditComponent.new(
      item: @item,
      section_recording: @section_recording
    ) %>
  <% end %>
<% else %>
  <% presskits_page_nav(
    title: "Item",
    back_url: edit_press_kit_section_path(@press_kit_recording, @section_recording),
    back_label: "Back to list",
    close_url: edit_press_kit_path(@press_kit_recording)
  ) %>

  <%= render RecordingStudioPresskits::ListItem::EditComponent.new(
    item: @item,
    section_recording: @section_recording
  ) %>
<% end %>
