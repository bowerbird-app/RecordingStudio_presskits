<% if presskits_editor_dialog? %>
  <%= flat_pack_modal_screen(modal_id: presskits_editor_modal_id, title: I18n.t("recording_studio_presskits.editor.header")) do %>
    <%= render RecordingStudioPresskits::PressKits::HeaderEditorComponent.new(
      press_kit_recording: @press_kit_recording,
      brand_color: @header_brand_color,
      font_family: @header_font_family,
      text_color: @header_text_color,
      corner_style: @header_corner_style,
      brand_source: @header_brand_source,
      location: @header_location,
      release_date: @header_release_date
    ) %>
  <% end %>
<% else %>
  <% presskits_page_nav(
    title: "Header",
    back_url: edit_press_kit_path(@press_kit_recording),
    back_label: "Back to kit",
    close_url: edit_press_kit_path(@press_kit_recording)
  ) %>

  <%= render FlatPack::PageTitle::Component.new(title: "Header", variant: :h1) %>

  <%= render RecordingStudioPresskits::PressKits::HeaderEditorComponent.new(
    press_kit_recording: @press_kit_recording,
    brand_color: @header_brand_color,
    font_family: @header_font_family,
    text_color: @header_text_color,
    corner_style: @header_corner_style,
    brand_source: @header_brand_source,
    location: @header_location,
    release_date: @header_release_date
  ) %>
<% end %>
