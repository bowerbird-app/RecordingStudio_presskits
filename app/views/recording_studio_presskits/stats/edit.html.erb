<% stat = @stat || @stat_recording.recordable %>
<% stat_title = stat.label.to_s.strip.presence || "Stat" %>
<% if presskits_editor_dialog? %>
  <%= flat_pack_modal_screen(modal_id: presskits_editor_modal_id, title: stat_title) do %>
    <%= render RecordingStudioPresskits::Stat::EditComponent.new(
      stat: stat,
      section_recording: @section_recording,
      stat_recording: @stat_recording
    ) %>
  <% end %>
<% else %>
  <% presskits_page_nav(
    title: stat_title,
    back_url: edit_press_kit_section_path(@press_kit_recording, @section_recording),
    back_label: "Back to stats",
    close_url: edit_press_kit_path(@press_kit_recording)
  ) %>

  <%= render RecordingStudioPresskits::Stat::EditComponent.new(
    stat: stat,
    section_recording: @section_recording,
    stat_recording: @stat_recording
  ) %>
<% end %>
