<% quote_title = presskits_title_for(@quote_recording) %>
<% if presskits_editor_dialog? %>
  <%= flat_pack_modal_screen(modal_id: presskits_editor_modal_id, title: quote_title) do %>
    <%= render RecordingStudioPresskits::Quote::EditComponent.new(
      quote_recording: @quote_recording,
      section_recording: @section_recording
    ) %>
  <% end %>
<% else %>
  <% presskits_page_nav(
    title: quote_title,
    back_url: edit_press_kit_section_path(@press_kit_recording, @section_recording),
    back_label: "Back to quotes",
    close_url: edit_press_kit_path(@press_kit_recording)
  ) %>

  <%= render RecordingStudioPresskits::Quote::EditComponent.new(
    quote_recording: @quote_recording,
    section_recording: @section_recording
  ) %>
<% end %>
