<% location = @location || @location_recording.recordable %>
<% location_title = location.display_name.presence || "Location" %>
<% if presskits_editor_dialog? %>
  <%= flat_pack_modal_screen(modal_id: presskits_editor_modal_id, title: location_title) do %>
    <%= render RecordingStudioPresskits::Locations::EditComponent.new(
      location: location,
      section_recording: @section_recording,
      location_recording: @location_recording
    ) %>
  <% end %>
<% else %>
  <% presskits_page_nav(
    title: location_title,
    back_url: edit_press_kit_section_path(@press_kit_recording, @section_recording),
    back_label: "Back to location",
    close_url: edit_press_kit_path(@press_kit_recording)
  ) %>

  <%= render RecordingStudioPresskits::Locations::EditComponent.new(
    location: location,
    section_recording: @section_recording,
    location_recording: @location_recording
  ) %>
<% end %>
